{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-router.mjs\"",
            "timeout": 8,
            "statusMessage": "Checking protected quota"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-router.mjs\"",
            "timeout": 8,
            "statusMessage": "Pacing this turn"
          }
        ]
      }
    ]
  }
}
