{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/node-bootstrap.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-router.mjs\"",
            "timeout": 8,
            "statusMessage": "Checking protected quota"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/node-bootstrap.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-router.mjs\"",
            "timeout": 8,
            "statusMessage": "Pacing this turn"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/node-bootstrap.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-router.mjs\"",
            "timeout": 8
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/node-bootstrap.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-router.mjs\"",
            "timeout": 8
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/node-bootstrap.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-router.mjs\"",
            "timeout": 8
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/node-bootstrap.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-router.mjs\"",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
