{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Usage Guard",
  "version": "0.1.0",
  "identifier": "sh.agentlayer.usage-guard.tray",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "title": "Usage Guard",
        "url": "index.html",
        "width": 380,
        "height": 640,
        "minWidth": 340,
        "minHeight": 480,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Usage Guard tray",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"]
  }
}
